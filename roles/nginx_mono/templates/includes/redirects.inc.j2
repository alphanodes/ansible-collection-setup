
# Redirects for {{ instance_name | default(instance.name) | default(nginx_mono_service_name) }}
{% if instance.redirects and instance.redirects | length > 0 %}
server {
  server_name {{ instance.redirects | join(' ') }};
  listen 80;
{% if nginx_with_ipv6 %}
  listen [::]:80;
{% endif %}

{% if nginx_with_ssl %}
  listen 443 {{ nginx_ssl_listen_option }};
{% if nginx_with_ipv6 %}
  listen [::]:443 {{ nginx_ssl_listen_option }};
{% endif %}

  {% include 'includes/modern_protocols.inc.j2' %}
{% if instance.redirects_ssl_cert is defined %}
  ssl_certificate /etc/ssl/certs/{{ instance.redirects_ssl_cert }}.crt;
  ssl_certificate_key /etc/ssl/private/{{ instance.redirects_ssl_cert }}.key;
{% else %}
  {% include 'includes/ssl.inc.j2' %}
{% endif %}
{% endif %}
{# Redirect names are part of the certificate as well, so they must answer the
   ACME challenge themselves - a redirect to another host would end up in a
   vhost without the challenge location. The redirect has to live inside
   "location /", a server level "return" would swallow the challenge
   requests. See port_redirect.inc.j2. #}
  include /etc/nginx/acme-challenge*.conf;
  location / {
{% if instance.server_port is defined and instance.server_port == 80 %}
    return 301 http://{{ instance.server_name }}$request_uri;
{% elif instance.server_port is defined and instance.server_port == 443 %}
    return 301 https://{{ instance.server_name }}$request_uri;
{% else %}
    return 301 $scheme://{{ instance.server_name }}$request_uri;
{% endif %}
  }
}
{% endif %}
