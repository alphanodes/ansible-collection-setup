  # Deny access based on the User-Agent header
  if ($bad_bot) {
    return 444;
  }

{% if instance.block_security_scanners | default(nginx_block_security_scanners) | bool %}
  # Deny self-declared internet scanners
  if ($security_scanner) {
    return 444;
  }

{% endif %}
{% if instance.block_ai_crawlers | default(nginx_block_ai_crawlers) | bool %}
  # Deny AI crawlers and AI assistants
  if ($ai_crawler) {
    return 444;
  }

{% endif %}
  # Block unwanted url requests
  if ($bad_locations) {
    return 404;
  }
{% if instance.block_unsafe_methods | default(false) %}

  # Protection against illegal HTTP methods. Out of the box only HEAD,
  # GET and POST are allowed.
  if ($not_allowed_method) {
    return 405;
  }
{% endif %}
