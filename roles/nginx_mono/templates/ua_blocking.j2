# Request header maps for blocking scanners and AI crawlers.
# Only effective in vhosts with block_security_scanners or
# block_ai_crawlers enabled, see includes/protection.inc.j2.

map $http_user_agent $security_scanner {
  default 0;
{% for user_agent in nginx_security_scanner_user_agents %}
  "~*{{ user_agent }}" 1;
{% endfor %}
}

# Injection payloads in headers that browsers fill with fixed values.
# Referer is left out, its query string may legitimately contain them.
map "$http_accept|$http_user_agent" $security_probe {
  default 0;
{% for pattern in nginx_security_probe_patterns %}
  "~{{ pattern }}" 1;
{% endfor %}
}

# Headers the application parses. The multipart boundary in Content-Type
# may contain dots and slashes, so only patterns that never occur in real
# values are checked here.
map "$http_content_type|$http_x_forwarded_for" $security_probe_parsed {
  default 0;
{% for pattern in nginx_security_probe_parsed_patterns %}
  "~{{ pattern }}" 1;
{% endfor %}
}

# Multipart form data needs a request body, GET and HEAD never carry one.
# Scanners send POST / with a multipart body to the bare IP, follow the
# redirect to the vhost as GET and keep the Content-Type header. Rack then
# parses an empty multipart body and Rails logs a BadRequest backtrace for
# every attempt.
map "$request_method|$http_content_type" $bodyless_multipart {
  default 0;
  "~*^(GET|HEAD)\|multipart/" 1;
}

map $http_user_agent $ai_crawler {
  default 0;
{% for user_agent in nginx_ai_crawler_user_agents %}
  "~*{{ user_agent }}" 1;
{% endfor %}
}
