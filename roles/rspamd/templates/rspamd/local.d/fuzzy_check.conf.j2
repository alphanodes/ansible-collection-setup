# Rspamd fuzzy check - local overrides
# see https://docs.rspamd.com/modules/fuzzy_check

# The fuzzy servers are external and reached over UDP, so every attempt
# against an unreachable server costs a full timeout. Both values are kept low
# so a fuzzy outage cannot push a scan into the task_timeout cap.
timeout = {{ rspamd_fuzzy_timeout | default('2s') }};
retransmits = {{ rspamd_fuzzy_retransmits | default(1) }};
{% if rspamd_fuzzy_servers | default('') | length > 0 %}

# Override the server list of the default rule
rule "rspamd.com" {
  servers = "{{ rspamd_fuzzy_servers }}";
}
{% endif %}
