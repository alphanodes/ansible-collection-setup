{{ managed_by_ansible | comment }}
# see https://starship.rs/config/

"$schema" = 'https://starship.rs/config-schema.json'

# Only the listed modules are shown, language modules are limited to php and ruby
# The os icon is static, the starship os module runs lsb_release on each prompt (~40ms)
format = """
$php\
{% if zsh_with_ruby %}
$ruby\
$username\
{% else %}
{% if ansible_facts['distribution'] == 'Debian' %}
[\uf306 ](bold white)\
{% elif ansible_facts['distribution'] == 'Ubuntu' %}
[\uf31b ](bold white)\
{% endif %}
{% if zsh_virtualization_type == 'kvm' %}
[ kvm ](bold yellow bg:red) \
{% else %}
[{{ zsh_virtualization_type }}](cyan) \
{% endif %}
{% endif %}
{% if prompt_hostname is defined %}
[{{ '@ ' if zsh_with_ruby else '' }}{{ prompt_hostname }}](bold yellow) \
{% else %}
$hostname\
{% endif %}
$directory\
$git_branch\
$git_commit\
$git_status\
$line_break\
$character"""

right_format = '$status$cmd_duration$jobs'

[username]
show_always = true
format = '[$user]($style) '

[hostname]
ssh_only = false
format = '[{{ '@ ' if zsh_with_ruby else '' }}$hostname]($style) '
style = 'bold yellow'

[directory]
style = 'bold 136'
truncation_length = 6
truncate_to_repo = false
read_only = " \U000f033e"

[git_status]
format = '([\[$all_status$ahead_behind\]]($style) )'

[git_commit]
# show tag if the current commit is tagged
tag_disabled = false
tag_symbol = '🏷️ '
only_detached = false
format = '([$tag]($style) )'

[ruby]
# ruby is a leading segment, so without the default 'via' prefix
format = '[$symbol($version )]($style)'
symbol = 'ruby '
style = 'white'

[php]
# php is a leading segment, so without the default 'via' prefix
format = '[$symbol($version )]($style)'
symbol = 'php '
style = 'white'
detect_extensions = ['php']
detect_files = ['composer.json', '.php-version']
detect_folders = []

[status]
disabled = false
