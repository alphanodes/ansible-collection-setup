#!/usr/sbin/nft -f
{{ managed_by_ansible | comment }}

# Only the tables of this role are replaced. A flush ruleset would also remove
# the table of fail2ban (inet f2b-table), the tables ip filter and ip nat belong
# to iptables-nft.
table inet netfilter
delete table inet netfilter

table inet netfilter {
{% if netfilter_honeypot_tcp_ports | length > 0 or netfilter_honeypot_udp_ports | length > 0 %}
  # sources probing the honeypot ports, every packet renews the timeout
  set honeypot {
    type ipv4_addr
    flags dynamic, timeout
    timeout {{ netfilter_honeypot_timeout }}
  }

  set honeypot6 {
    type ipv6_addr
    flags dynamic, timeout
    timeout {{ netfilter_honeypot_timeout }}
  }

{% endif %}
  chain input {
    type filter hook input priority filter; policy {{ netfilter_filter_input_policy | lower }};

    iif lo accept
    ct state established,related accept
    ct state invalid drop

    # a new connection starts with a SYN, conntrack accepts other packets as new
    tcp flags & (fin | syn | rst | ack) != syn ct state new drop

    # remote packets claiming to come from or go to a loopback address
    iif != lo ip saddr 127.0.0.0/8 drop
    iif != lo ip daddr 127.0.0.0/8 drop
    iif != lo ip6 saddr ::1 drop

    # packets to broadcast, multicast or anycast addresses
    meta nfproto ipv4 fib daddr type { broadcast, multicast, anycast } drop
    ip daddr 224.0.0.0/4 drop

{% for blocked_address in netfilter_blocked_addresses %}
    ip saddr {{ blocked_address }} drop
{% endfor %}
{% for blocked_address in netfilter_blocked_addresses_v6 %}
    ip6 saddr {{ blocked_address }} drop
{% endfor %}

    # no redirects or timestamps, IPv6 needs neighbor discovery and packet too big
    icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
    icmp type echo-request limit rate {{ netfilter_icmp_echo_limit }} accept
    icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert, mld-listener-query } accept
    icmpv6 type echo-request limit rate {{ netfilter_icmp_echo_limit }} accept

    # trusted sources and ssh come first, a honeypot hit must not lock them out
{% for allowed_network in netfilter_allowed_networks %}
    ip saddr {{ allowed_network }} accept
{% endfor %}
{% for allowed_network in netfilter_allowed_networks_v6 %}
    ip6 saddr {{ allowed_network }} accept
{% endfor %}
{% for allowed_tcp in netfilter_allowed_tcp_ports_with_saddr %}
    ip saddr {{ allowed_tcp.saddr }} tcp dport {{ allowed_tcp.port | string | replace(':', '-') }} accept
{% endfor %}
{% for allowed_udp in netfilter_allowed_udp_ports_with_saddr %}
    ip saddr {{ allowed_udp.saddr }} udp dport {{ allowed_udp.port | string | replace(':', '-') }} accept
{% endfor %}
{% for allowed_tcp in netfilter_allowed_tcp_ports_with_saddr_v6 %}
    ip6 saddr {{ allowed_tcp.saddr }} tcp dport {{ allowed_tcp.port | string | replace(':', '-') }} accept
{% endfor %}
{% for allowed_udp in netfilter_allowed_udp_ports_with_saddr_v6 %}
    ip6 saddr {{ allowed_udp.saddr }} udp dport {{ allowed_udp.port | string | replace(':', '-') }} accept
{% endfor %}

    # ssh
{% if netfilter_ssh_sources | length > 0 %}
{% for ssh_source in netfilter_ssh_sources %}
    ip saddr {{ ssh_source }} tcp dport {{ ssh_server_port | default('22') }} accept
{% endfor %}
{% else %}
    meta nfproto ipv4 tcp dport {{ ssh_server_port | default('22') }} accept
{% endif %}
{% if netfilter_ssh_sources_v6 | length > 0 %}
{% for ssh_source in netfilter_ssh_sources_v6 %}
    ip6 saddr {{ ssh_source }} tcp dport {{ ssh_server_port | default('22') }} accept
{% endfor %}
{% else %}
    meta nfproto ipv6 tcp dport {{ ssh_server_port | default('22') }} accept
{% endif %}

    # zabbix
{% if netfilter_allow_zabbix_server and netfilter_zabbix_server_address != '' %}
    ip saddr {{ netfilter_zabbix_server_address }} tcp dport {{ netfilter_zabbix_server_port }} accept
{% endif %}
{% if netfilter_allow_zabbix_server and netfilter_zabbix_server_address_v6 != '' %}
    ip6 saddr {{ netfilter_zabbix_server_address_v6 }} tcp dport {{ netfilter_zabbix_server_port }} accept
{% endif %}
{% for active_zabbix_address in netfilter_allowed_active_zabbix_addresses %}
    ip saddr {{ active_zabbix_address }} tcp dport 10051 accept
{% endfor %}
{% if netfilter_allowed_active_zabbix_addresses_v6_all %}
    meta nfproto ipv6 tcp dport 10051 accept
{% else %}
{% for active_zabbix_address in netfilter_allowed_active_zabbix_addresses_v6 %}
    ip6 saddr {{ active_zabbix_address }} tcp dport 10051 accept
{% endfor %}
{% endif %}
{% if netfilter_honeypot_tcp_ports | length > 0 or netfilter_honeypot_udp_ports | length > 0 %}

    # honeypot: known scanners also lose the public ports below
    ip saddr @honeypot update @honeypot { ip saddr } drop
    ip6 saddr @honeypot6 update @honeypot6 { ip6 saddr } drop
{% endif %}

    # public ports
{% for allowed_tcp_port in netfilter_allowed_tcp_ports %}
    tcp dport {{ allowed_tcp_port | string | replace(':', '-') }} accept
{% endfor %}
{% for allowed_udp_port in netfilter_allowed_udp_ports %}
    udp dport {{ allowed_udp_port | string | replace(':', '-') }} accept
{% endfor %}
{% if netfilter_honeypot_tcp_ports | length > 0 %}

    # honeypot traps, behind the public ports so an opened port is no trap
    tcp dport { {{ netfilter_honeypot_tcp_ports | join(', ') }} } update @honeypot { ip saddr } log prefix "HONEYPOT: " level info drop
    tcp dport { {{ netfilter_honeypot_tcp_ports | join(', ') }} } update @honeypot6 { ip6 saddr } log prefix "HONEYPOT: " level info drop
{% endif %}
{% if netfilter_honeypot_udp_ports | length > 0 %}
    udp dport { {{ netfilter_honeypot_udp_ports | join(', ') }} } update @honeypot { ip saddr } log prefix "HONEYPOT: " level info drop
    udp dport { {{ netfilter_honeypot_udp_ports | join(', ') }} } update @honeypot6 { ip6 saddr } log prefix "HONEYPOT: " level info drop
{% endif %}
{% if netfilter_log_dropped_packets %}
{% if netfilter_silent_drop_udp_ports | length > 0 %}

    # local network chatter would fill the log sample below
    udp dport { {{ netfilter_silent_drop_udp_ports | join(', ') }} } drop
{% endif %}

    # everything else is dropped by the policy, log a sample
    limit rate 15/minute log prefix "netfilter-dropped: " level debug
{% endif %}
  }

  chain forward {
    type filter hook forward priority filter; policy {{ netfilter_filter_forward_policy | lower }};
{% if netfilter_filter_forward_policy | lower != 'accept' %}

    oif lo accept
    ct state established,related accept
{% for allowed_network in netfilter_allowed_networks %}
    ip saddr {{ allowed_network }} accept
{% endfor %}
{% for allowed_network in netfilter_allowed_networks_v6 %}
    ip6 saddr {{ allowed_network }} accept
{% endfor %}
{% for forward in netfilter_forward %}
{% if forward.dport is defined %}
    {{ 'ip saddr ' ~ forward.saddr ~ ' ' if forward.saddr is defined else '' }}ip daddr {{ forward.daddr }} {{ forward.prot | default('tcp') }} dport {{ forward.dport }} accept
{% else %}
    {{ 'ip saddr ' ~ forward.saddr ~ ' ' if forward.saddr is defined else '' }}ip daddr {{ forward.daddr }} meta l4proto {{ forward.prot | default('tcp') }} accept
{% endif %}
{% if forward.saddr_v6 is defined and forward.daddr_v6 is defined %}
{% if forward.dport is defined %}
    ip6 saddr {{ forward.saddr_v6 }} ip6 daddr {{ forward.daddr_v6 }} {{ forward.prot | default('tcp') }} dport {{ forward.dport }} accept
{% else %}
    ip6 saddr {{ forward.saddr_v6 }} ip6 daddr {{ forward.daddr_v6 }} meta l4proto {{ forward.prot | default('tcp') }} accept
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
  }

  chain output {
    type filter hook output priority filter; policy {{ netfilter_filter_output_policy | lower }};

    oif lo accept
    ct state established,related accept
{% set metadata_users = netfilter_metadata_blocked_users | select('in', ansible_facts.getent_passwd) | list %}
{% if metadata_users | length > 0 and netfilter_metadata_addresses | length > 0 %}

    # web applications have no use for the cloud metadata service, an SSRF could
    # read access tokens from it
    meta skuid { {{ metadata_users | map('to_json') | join(', ') }} } ip daddr { {{ netfilter_metadata_addresses | join(', ') }} } reject
{% endif %}
{% set smtp_users = netfilter_output_smtp_users | select('in', ansible_facts.getent_passwd) | list %}
{% if smtp_users | length > 0 %}

    # only the mail server talks SMTP to other hosts, nothing that got into a
    # web application can send spam directly
    tcp dport 25 meta skuid != { {{ smtp_users | map('to_json') | join(', ') }} } limit rate 15/minute log prefix "netfilter-smtp-output: " level info
    tcp dport 25 meta skuid != { {{ smtp_users | map('to_json') | join(', ') }} } reject
{% endif %}
{% if netfilter_filter_output_policy | lower != 'accept' %}

{% for allowed_network in netfilter_allowed_networks_output %}
    ip daddr {{ allowed_network }} accept
{% endfor %}
{% for allowed_network in netfilter_allowed_networks_output_v6 %}
    ip6 daddr {{ allowed_network }} accept
{% endfor %}
{% endif %}
  }
}

# declared and deleted unconditionally, so emptied NAT lists remove the table
table ip netfilter-nat
delete table ip netfilter-nat
{% if netfilter_prerouting | length > 0 or netfilter_postrouting | length > 0 %}

table ip netfilter-nat {
  chain prerouting {
    type nat hook prerouting priority dstnat; policy {{ netfilter_nat_prerouting_policy | lower }};
{% for prerouting in netfilter_prerouting %}
{% if prerouting.prot is defined and prerouting.prot == 'icmp' %}
    ip daddr {{ prerouting.daddr }} ip protocol icmp dnat to {{ prerouting.dest }}
{% else %}
    {{ 'ip saddr ' ~ prerouting.saddr ~ ' ' if prerouting.saddr is defined else '' }}ip daddr {{ prerouting.daddr }} {{ prerouting.prot | default('tcp') }} dport {{ prerouting.dport }} dnat to {{ prerouting.dest }}
{% endif %}
{% endfor %}
  }

  chain postrouting {
    type nat hook postrouting priority srcnat; policy {{ netfilter_nat_postrouting_policy | lower }};
{% for postrouting in netfilter_postrouting %}
    oifname "{{ postrouting.oifname }}" ip saddr {{ postrouting.saddr }} snat to {{ postrouting.snat_to }}
{% endfor %}
  }
}
{% endif %}
