#!/bin/bash
{{ managed_by_ansible | comment }}
#
# Zabbix checks that need root (through the sudoers rules of the
# zabbix_agent role) or are not covered by the agent itself.
#
# Usage: linux_check.sh <key> <source>
#   linux_check.sh PasswordAuthentication sshd_config
#   linux_check.sh world_write_etc perm
#   linux_check.sh server_name_in_hosts performance
#   linux_check.sh password_accounts users
#
# The TLS certificate check uses the agent key web.certificate.get.

# A failing sudo in a pipeline (e.g. sudo find | wc -l) has to fail the check
set -o pipefail

key="$1"
source="$2"

# Error value: displayable in Zabbix (no NOT_SUPPORTED) and distinguishable
# from real values by the triggers
ERROR_VALUE="-0.9902"

fail() {
  echo "$ERROR_VALUE"
  exit 1
}

# Effective sshd configuration value, sshd -T includes all sshd_config.d
# drop-ins (keys are lower case there)
get_sshd_config() {
  local value
  value=$(sudo -n /usr/sbin/sshd -T 2>/dev/null | awk -v k="${key,,}" '$1 == k { print $2; exit }')
  [ -n "$value" ] || fail
  echo "$value"
}

# Number of world writable files and directories in /etc
get_file_permission() {
  local files dirs
  [ "$key" = "world_write_etc" ] || fail
  files=$(sudo -n /usr/bin/find /etc -type f -perm -002 | wc -l) || fail
  dirs=$(sudo -n /usr/bin/find /etc -type d -perm -002 | wc -l) || fail
  echo $((files + dirs))
}

# Whether the host name has an entry in /etc/hosts
get_performance() {
  [ "$key" = "server_name_in_hosts" ] || fail
  if grep -qw -- "$(hostname)" /etc/hosts; then
    echo yes
  else
    echo no
  fi
}

# Accounts with a usable password, sorted and space separated ("none" if
# there are none)
get_users() {
  local status accounts
  [ "$key" = "password_accounts" ] || fail
  status=$(sudo -n /usr/bin/passwd -S -a 2>/dev/null) || fail
  [ -n "$status" ] || fail
  accounts=$(awk '$2 == "P" { print $1 }' <<< "$status" | sort | paste -sd ' ')
  echo "${accounts:-none}"
}

[ -n "$key" ] || fail

case "$source" in
  sshd_config) get_sshd_config ;;
  perm) get_file_permission ;;
  performance) get_performance ;;
  users) get_users ;;
  *) fail ;;
esac
