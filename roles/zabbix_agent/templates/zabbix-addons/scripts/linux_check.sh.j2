#!/bin/bash
{{ managed_by_ansible | comment }}
#
# Zabbix checks that need root (through the sudoers rules of the
# zabbix_agent role) or are not covered by the agent itself.
#
# Usage: linux_check.sh <key> <source>
#   linux_check.sh PasswordAuthentication sshd_config
#   linux_check.sh auth_methods sshd
#   linux_check.sh match_password sshd
#   linux_check.sh world_write_etc perm
#   linux_check.sh server_name_in_hosts performance
#   linux_check.sh password_accounts users
#   linux_check.sh queue_count postfix
#   linux_check.sh queue_age postfix
#
# The TLS certificate check uses the agent key web.certificate.get.

# A failing sudo in a pipeline (e.g. sudo find | wc -l) has to fail the check
set -o pipefail

key="$1"
source="$2"

# Error value: displayable in Zabbix (no NOT_SUPPORTED) and distinguishable
# from real values by the triggers
ERROR_VALUE="-0.9902"

fail() {
  echo "$ERROR_VALUE"
  exit 1
}

# Effective sshd configuration value, sshd -T includes all sshd_config.d
# drop-ins (keys are lower case there)
get_sshd_config() {
  local value
  value=$(sudo -n /usr/sbin/sshd -T 2>/dev/null | awk -v k="${key,,}" '$1 == k { print $2; exit }')
  [ -n "$value" ] || fail
  echo "$value"
}

# Authentication methods the running sshd offers, comma separated: the
# "Permission denied (...)" list of a local login without authentication.
# Unlike sshd -T this is the loaded configuration and includes PAM
# keyboard-interactive. A wildcard listener is reached on localhost.
get_sshd_auth_methods() {
  local config listen address host port reply methods
  config=$(sudo -n /usr/sbin/sshd -T 2>/dev/null) || fail
  listen=$(awk '$1 == "listenaddress" { print $2 }' <<< "$config")
  address=$(grep -m1 -E '^0\.0\.0\.0:' <<< "$listen" || grep -m1 -E '^\[::\]:' <<< "$listen" || head -1 <<< "$listen")
  [ -n "$address" ] || fail
  port=${address##*:}
  host=${address%:*}
  host=${host#[}
  host=${host%]}
  case "$host" in
    0.0.0.0) host=127.0.0.1 ;;
    ::) host=::1 ;;
  esac
  reply=$(ssh -F /dev/null -p "$port" -o BatchMode=yes -o ConnectTimeout=3 \
    -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o GlobalKnownHostsFile=/dev/null \
    -o PreferredAuthentications=none -o LogLevel=ERROR "zabbix@$host" true 2>&1 < /dev/null)
  methods=$(sed -n 's/.*Permission denied (\([^)]*\)).*/\1/p' <<< "$reply" | head -1)
  [ -n "$methods" ] || fail
  echo "$methods"
}

get_sshd() {
  case "$key" in
    auth_methods) get_sshd_auth_methods ;;
    # Match blocks that allow passwords, sshd -T only shows global values
    match_password) sudo -n {{ zabbix_addons_dir }}/scripts/sshd_match_check.sh || fail ;;
    *) fail ;;
  esac
}

# Number of world writable files and directories in /etc
get_file_permission() {
  local files dirs
  [ "$key" = "world_write_etc" ] || fail
  files=$(sudo -n /usr/bin/find /etc -type f -perm -002 | wc -l) || fail
  dirs=$(sudo -n /usr/bin/find /etc -type d -perm -002 | wc -l) || fail
  echo $((files + dirs))
}

# Whether the host name has an entry in /etc/hosts
get_performance() {
  [ "$key" = "server_name_in_hosts" ] || fail
  if grep -qw -- "$(hostname)" /etc/hosts; then
    echo yes
  else
    echo no
  fi
}

# Accounts with a usable password, sorted and space separated ("none" if
# there are none)
get_users() {
  local status accounts
  [ "$key" = "password_accounts" ] || fail
  status=$(sudo -n /usr/bin/passwd -S -a 2>/dev/null) || fail
  [ -n "$status" ] || fail
  accounts=$(awk '$2 == "P" { print $1 }' <<< "$status" | sort | paste -sd ' ')
  echo "${accounts:-none}"
}

# Mails in the postfix queue and age of the oldest one in seconds. Deferred
# mails are ignored by the journal checks, a relay that keeps rejecting them
# (wrong credentials, sender not allowed) only shows up here. postqueue needs
# no root. Without postfix both values are 0.
get_postfix() {
  local queue oldest
  if ! command -v postqueue > /dev/null; then
    echo 0
    return
  fi
  queue=$(postqueue -j 2>/dev/null) || fail
  case "$key" in
    queue_count)
      grep -c . <<< "$queue" || true
      ;;
    queue_age)
      oldest=$(grep -o '"arrival_time": *[0-9]*' <<< "$queue" | grep -o '[0-9]*$' | sort -n | head -1)
      if [ -n "$oldest" ]; then
        echo $(($(date +%s) - oldest))
      else
        echo 0
      fi
      ;;
    *) fail ;;
  esac
}

[ -n "$key" ] || fail

case "$source" in
  sshd_config) get_sshd_config ;;
  sshd) get_sshd ;;
  perm) get_file_permission ;;
  performance) get_performance ;;
  users) get_users ;;
  postfix) get_postfix ;;
  *) fail ;;
esac
