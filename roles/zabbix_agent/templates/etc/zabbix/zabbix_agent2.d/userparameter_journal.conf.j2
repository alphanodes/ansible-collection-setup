{{ managed_by_ansible | comment }}
#
# Journal checks of the Linux and Journal templates

UserParameter=error_log[*], journalctl {{ zabbix_agent_journalctl_options }} -p3 --since "{{ zabbix_agent_journalctl_since }}" | grep -Ev '^--'
UserParameter=security_log[*], journalctl {{ zabbix_agent_journalctl_options }} --since "$1 hours ago" SYSLOG_FACILITY=4 | grep -Evi 'disconnected from|connection closed by|disconnecting invalid' | grep -Ei 'invalid user'
UserParameter=kernel_log[*], journalctl {{ zabbix_agent_journalctl_options }} -k -p 2 --since "{{ zabbix_agent_journalctl_since }}" | grep -Ev '^--'
UserParameter=journalctl_service[*], bash {{ zabbix_addons_dir }}/scripts/journal_check.sh service "$1"
UserParameter=journalctl[*], bash {{ zabbix_addons_dir }}/scripts/journal_check.sh global
