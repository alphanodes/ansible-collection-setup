#
# Zabbix agent UserParameters for the Matomo Tracker template.
# Inline queries; no wrapper scripts. Run as the zabbix user.

# SCAN instead of KEYS, which blocks Redis. If Redis does not answer, the
# text output makes the numeric item unsupported instead of reporting 0.
UserParameter=matomo.queue.total_size,redis-cli ping | grep -qx PONG || { echo 'redis unavailable'; exit 1; }; redis-cli --scan --pattern 'trackingQueueV1*' | xargs -r -I{} redis-cli LLEN {} | awk '{s+=$1} END {print s+0}'
UserParameter=matomo.queue.worker_timer_state,systemctl is-active matomo-queuedtracking.timer 2>/dev/null || true
