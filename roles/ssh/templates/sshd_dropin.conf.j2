{{ managed_by_ansible | comment }}
# Included at the top of /etc/ssh/sshd_config. sshd uses the first value it
# reads for most keywords, so these settings win against the rest of
# sshd_config and against drop-ins sorted after this file.

Port {{ ssh_server_port }}

{% for key in ssh_server_hostkeys %}
HostKey {{ key }}
{% endfor %}

{% if ssh_max_secure %}
# see https://infosec.mozilla.org/guidelines/openssh#modern-openssh-67
{% if ssh_host_key_algorithms %}
HostKeyAlgorithms {{ ssh_host_key_algorithms | join(',') }}
{% endif %}
{{ 'Ciphers ' ~ ssh_ciphers | join(',') }}
{{ 'MACs ' ~ ssh_macs | join(',') }}
{{ 'KexAlgorithms ' ~ ssh_kex | join(',') }}

{% endif %}
SyslogFacility AUTH
LogLevel {{ ssh_server_log_level }}

LoginGraceTime {{ ssh_server_login_grace_time }}
MaxAuthTries {{ ssh_max_auth_retries }}
{% if ssh_server_max_startups | length > 0 %}
MaxStartups {{ ssh_server_max_startups }}
{% endif %}

PermitRootLogin {{ ssh_server_permit_root_login }}
{% if ssh_deny_users != '' %}
DenyUsers {{ ssh_deny_users }}
{% endif %}
{% if ssh_deny_groups != '' %}
DenyGroups {{ ssh_deny_groups }}
{% endif %}
StrictModes yes

AuthenticationMethods {{ ssh_server_authentication_methods }}
PubkeyAuthentication yes
AuthorizedKeysFile %h/.ssh/authorized_keys
RevokedKeys /etc/ssh/revoked_keys
IgnoreRhosts yes
HostbasedAuthentication no
PermitEmptyPasswords no
KbdInteractiveAuthentication {{ 'yes' if ssh_server_challenge_response_authentication | bool else 'no' }}
PasswordAuthentication {{ 'yes' if ssh_server_password_authentication | bool else 'no' }}
UsePAM {{ 'yes' if ssh_server_use_pam | bool else 'no' }}

AllowTcpForwarding {{ 'yes' if ssh_server_allow_tcp_forwarding | bool else 'no' }}
AllowStreamLocalForwarding {{ 'yes' if ssh_server_allow_stream_local_forwarding | bool else 'no' }}
# A local X11 display could be accessed through a forwarded connection
X11Forwarding no

DebianBanner no
PrintMotd no
PrintLastLog yes
TCPKeepAlive yes
ClientAliveInterval {{ ssh_server_client_alive_interval }}
ClientAliveCountMax {{ ssh_server_client_alive_count_max }}

# Allow client to pass locale environment variables
AcceptEnv LANG LC_*

{% if ssh_server_sftp_enabled %}
# Log sftp level file access (read/write/etc.) that would not be easily logged otherwise.
Subsystem sftp {{ ssh_server_subsystem_sftp }}
{% else %}
# Disabled, the first value wins against sftp-server of sshd_config
Subsystem sftp /bin/false
{% endif %}
{% if ssh_server_match_user or ssh_server_match_group %}

# Match blocks end with this file, they do not affect sshd_config
{% endif %}
{% if ssh_server_match_user %}
{% for item in ssh_server_match_user %}
Match User {{ item.user }}
    {{ item.rules | indent(4) }}
{% endfor %}
{% endif %}
{% if ssh_server_match_group %}
{% for item in ssh_server_match_group %}
Match Group {{ item.group }}
    {{ item.rules | indent(4) }}
{% endfor %}
{% endif %}
