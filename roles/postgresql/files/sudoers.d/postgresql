# Only the collation check of the Zabbix agent (UserParameter
# pg_collation_mismatch), never arbitrary commands as postgres. The query is
# read from a root owned file: sudo-rs (Ubuntu 26.04) rejects escaped
# wildcards and does not match arguments containing spaces
zabbix ALL = (postgres) NOPASSWD: /usr/bin/psql -t -A -f /etc/zabbix/pg_collation_mismatch.sql
