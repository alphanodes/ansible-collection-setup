);
INSERT INTO pg_stat_bgwriter VALUES (1, 2, 3);
CREATE TEMP TABLE pg_stat_checkpointer (
    num_timed bigint, num_requested bigint, write_time double precision,
    sync_time double precision, buffers_written bigint
);
